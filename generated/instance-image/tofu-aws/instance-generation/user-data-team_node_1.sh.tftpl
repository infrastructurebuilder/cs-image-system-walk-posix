#!/usr/bin/env bash
# cs-image-system launch parameters for instance team-node-1-001 (N26).
# Generated from validated configuration; immutable after launch --
# changing them means replacing the instance.
set -euo pipefail
hostnamectl set-hostname 'team-node-1-001' || true
# owning group: walk_posix (gid by reference)
GID="${group_gid}"
# mount storage data (ebs) at /mnt/data
mkdir -p '/mnt/data'
DEV='/dev/xvdf'
VOL="${ebs["data"].volume_id}"
BYID="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$(printf '%s' "$VOL" | tr -d -)"
# the attachment lands after boot: wait for either name
for i in $(seq 1 60); do [ -e "$DEV" ] && break; [ -e "$BYID" ] && DEV="$BYID" && break; sleep 2; done
if ! blkid "$DEV" >/dev/null 2>&1; then mkfs -t xfs "$DEV"; fi
grep -q ' /mnt/data ' /etc/fstab || echo "$DEV /mnt/data xfs defaults,nofail 0 2" >> /etc/fstab
mount '/mnt/data' || mount "$DEV" '/mnt/data'
mkdir -p '/mnt/data/walk_posix'
chgrp "$GID" '/mnt/data/walk_posix'
chmod 2770 '/mnt/data/walk_posix'
mkdir -p /var/lib/csis
date -u +%FT%TZ > /var/lib/csis/launch-applied