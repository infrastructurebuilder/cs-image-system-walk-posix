# Terraform module call for instance team-node-1 generated by TofuInstanceBuilder (tofu-aws)
# owning group: walk_posix (via image team-node); launch parameters recorded in meta-state/launch-params.yaml (N26)
module "instance_team_node_1" {
  source                      = "../../../../tfmodules/aws_instance"
  providers                   = { aws = aws.tofu_aws }
  name                        = "team-node-1"
  ami_id                      = var.team_node_1_ami_id
  ami_name_pattern            = "team-node-packer-ebs*"
  instance_type               = "t3.medium"
  associate_public_ip_address = false
  vpc_security_group_ids      = [aws_security_group.csis_instances.id, "sg-03015ec107ae5f81a"]
  subnet_id                   = "subnet-09f79018af845358a"
  iam_instance_profile        = "AmazonSSMRoleForInstancesQuickSetup"
  tags                        = { "role" = "node" }
  user_data = templatefile("${path.module}/user-data-team_node_1.sh.tftpl", {
    "ebs" = {
      "data" = {
        "device_name" = "/dev/xvdf"
        "volume_id"   = data.terraform_remote_state.aws_ebs.outputs.storage_data.volume_id
      }
    }
    "efs"                  = {}
    "group_gid"            = 3000
    "sft_enrollment_token" = ""
  })
  ebs_volumes = {
    "data" = {
      "device_name" = "/dev/xvdf"
      "volume_id"   = data.terraform_remote_state.aws_ebs.outputs.storage_data.volume_id
    }
  }
}